ENVIRONMENT=development
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/cropscan
MONGODB_DB_NAME=cropscan
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PREDICTION_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
MODEL_DIR=models
GEMINI_API_KEY=replace-with-your-gemini-api-key
# gemini-2.5-flash requires prepayment credits. Use gemini-2.5-flash-lite
# (or gemini-2.0-flash) if your project is on the free tier.
GEMINI_MODEL=gemini-2.5-flash
# Set to true to call Gemini via Vertex AI (uses GCP $300 credit, service-account auth)
# instead of the AI Studio API key. When true, GEMINI_API_KEY is ignored.
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Path inside the container; mount your service-account JSON read-only via docker-compose.
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/sa.json
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=CropScan <onboarding@yourdomain.com>
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
EMAIL_DEBUG_OTP=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=
TRUST_PROXY_HEADERS=false
PASSWORD_RESET_RESPONSE_DELAY_SECONDS=0.3
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_LOCKOUT_MINUTES=60
MAX_SCANS_PER_USER=2000
MAX_PLOTS_PER_USER=50
# S3 training-feedback uploads (optional). When all four are set, the "share
# for training" toggle on the scan feedback panel uploads the misclassified
# image to S3. Without them, the rest of the feedback flow still works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=
# Walk-scan leaf gating via a YOLO model (opt-in). Requires `pip install
# ultralytics`. Generic COCO weights do not include a "leaf" class, so leave
# OFF unless you have a leaf-trained weight file you can point WALK_LEAF_YOLO_MODEL at.
WALK_LEAF_YOLO_ENABLED=false
WALK_LEAF_YOLO_MODEL=yolo11n.pt
